# Ignore runtime data, downloaded ZIM archives, Ollama models, and SQLite databases
storage/app_data/*
!storage/app_data/.gitkeep

storage/ollama_data/*
!storage/ollama_data/.gitkeep

storage/zim_files/*
!storage/zim_files/.gitkeep

# Ignore Python bytecode and temporary files
__pycache__/
*.py[cod]
*$py.class
*.swp
*.bak
.DS_Store
*.aria2
