#!/usr/bin/env bash
# ==============================================================================
# bunker-library — CLI Launcher & Controller for BunkerOS XP
# Behavior:
#   - `bunker-library`         : If not running, starts containers & opens http://localhost.
#                                If already running, immediately opens http://localhost.
#   - `bunker-library stop`    : Stops the running containers.
#   - `bunker-library restart` : Restarts the containers and opens http://localhost.
#   - `bunker-library status`  : Displays container and HTTP health status.
#   - `bunker-library build`   : Rebuilds the container image and opens http://localhost.
#   - `bunker-library logs`    : Follows container logs.
#   - `bunker-library uninstall`: Stops containers and removes the CLI command.
# ==============================================================================
set -euo pipefail

REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
BIN_DIR="$(cd "$(dirname "${REAL_SCRIPT}")" && pwd)"
PROJECT_ROOT="$(cd "${BIN_DIR}/.." && pwd)"
URL="http://localhost"

log_info() { printf "\033[1;34m[bunker-library]\033[0m %s\n" "$*"; }
log_ok()   { printf "\033[1;32m[bunker-library]\033[0m %s\n" "$*"; }
log_warn() { printf "\033[1;33m[bunker-library]\033[0m %s\n" "$*"; }

is_running() {
    docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^bunker-xp$" && \
    curl -fsS --max-time 2 "${URL}/api/system/status" >/dev/null 2>&1
}

wait_until_ready() {
    log_info "Waiting for ${URL} to become ready..."
    for _ in {1..45}; do
        if curl -fsS --max-time 2 "${URL}/api/system/status" >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
    done
    log_warn "Service is taking longer than expected. Check 'bunker-library logs' if ${URL} does not load."
    return 0
}

open_browser() {
    local target_url="${1:-${URL}}"
    log_ok "Opening BunkerOS App Window (${target_url})..."
    if [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
        log_info "No GUI display detected in current shell. Access the interface at: ${target_url}"
        return 0
    fi

    # Prefer dedicated chromeless App Window mode (--app=...) for an authentic OS feel
    if command -v google-chrome >/dev/null 2>&1; then
        nohup google-chrome --app="${target_url}" >/dev/null 2>&1 &
    elif command -v chromium >/dev/null 2>&1; then
        nohup chromium --app="${target_url}" >/dev/null 2>&1 &
    elif command -v chromium-browser >/dev/null 2>&1; then
        nohup chromium-browser --app="${target_url}" >/dev/null 2>&1 &
    elif command -v brave-browser >/dev/null 2>&1; then
        nohup brave-browser --app="${target_url}" >/dev/null 2>&1 &
    elif command -v microsoft-edge >/dev/null 2>&1; then
        nohup microsoft-edge --app="${target_url}" >/dev/null 2>&1 &
    elif command -v xdg-open >/dev/null 2>&1; then
        nohup xdg-open "${target_url}" >/dev/null 2>&1 &
    elif command -v sensible-browser >/dev/null 2>&1; then
        nohup sensible-browser "${target_url}" >/dev/null 2>&1 &
    elif command -v x-www-browser >/dev/null 2>&1; then
        nohup x-www-browser "${target_url}" >/dev/null 2>&1 &
    elif command -v firefox >/dev/null 2>&1; then
        nohup firefox "${target_url}" >/dev/null 2>&1 &
    else
        log_info "Navigate to ${target_url} in your browser."
    fi
}

cmd_start_or_open() {
    local mode_suffix="${1:-}"
    local target_url="${URL}${mode_suffix}"
    if is_running; then
        log_ok "BunkerOS XP / Microsoft Bob is already running."
        open_browser "${target_url}"
    else
        log_info "BunkerOS is not running. Starting containers..."
        cd "${PROJECT_ROOT}"
        docker compose up -d
        wait_until_ready
        log_ok "BunkerOS started!"
        open_browser "${target_url}"
    fi
}

cmd_stop() {
    log_info "Stopping BunkerOS XP containers..."
    cd "${PROJECT_ROOT}"
    docker compose down --remove-orphans
    log_ok "BunkerOS XP stopped."
}

cmd_restart() {
    log_info "Restarting BunkerOS XP containers..."
    cd "${PROJECT_ROOT}"
    docker compose restart
    wait_until_ready
    open_browser
}

cmd_build() {
    log_info "Building and starting BunkerOS XP containers..."
    cd "${PROJECT_ROOT}"
    docker compose up -d --build
    wait_until_ready
    open_browser
}

cmd_status() {
    cd "${PROJECT_ROOT}"
    docker compose ps
    echo ""
    if is_running; then
        log_ok "Status: ONLINE at ${URL}"
        curl -fsS "${URL}/api/system/status" && echo ""
    else
        log_warn "Status: STOPPED (run 'bunker-library' to start and open ${URL})"
    fi
}

cmd_uninstall() {
    log_info "Stopping and removing BunkerOS XP containers..."
    cd "${PROJECT_ROOT}"
    docker compose down --remove-orphans 2>/dev/null || true
    docker rm -f bunker-xp bunker-ollama 2>/dev/null || true

    rm -f "${HOME}/.local/bin/bunker-library"
    if [[ -w /usr/local/bin ]]; then
        rm -f /usr/local/bin/bunker-library
    fi

    if [[ "${1:-}" == "--purge" ]]; then
        log_info "Purging saved chats database (storage/app_data)..."
        rm -rf "${PROJECT_ROOT}/storage/app_data/"* 2>/dev/null || true
    fi

    log_ok "Uninstalled 'bunker-library' command and stopped all containers."
}

case "${1:-}" in
    ""|start|open|xp)
        cmd_start_or_open ""
        ;;
    bob)
        cmd_start_or_open "/?env=bob"
        ;;
    code|vscode|workspace)
        cmd_start_or_open "/?workspace=1"
        ;;
    stop|down)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    build|rebuild)
        cmd_build
        ;;
    status)
        cmd_status
        ;;
    logs)
        cd "${PROJECT_ROOT}"
        docker compose logs -f
        ;;
    uninstall)
        shift
        cmd_uninstall "${1:-}"
        ;;
    help|--help|-h)
        echo "Usage: bunker-library [command]"
        echo ""
        echo "Commands:"
        echo "  (no args)   Start containers if not running, then open http://localhost"
        echo "  stop        Stop the BunkerOS XP containers"
        echo "  restart     Restart containers and open http://localhost"
        echo "  status      Show container and API status"
        echo "  build       Rebuild container image and open http://localhost"
        echo "  logs        Tail container logs"
        echo "  uninstall   Stop containers and remove the bunker-library CLI command"
        ;;
    *)
        log_warn "Unknown command: $1 (try 'bunker-library --help')"
        exit 1
        ;;
esac
